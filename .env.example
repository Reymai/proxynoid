# Required environment variables
DO_API_TOKEN=your_master_digitalocean_token_here
PROXY_KEYS={"deploy_pipeline":"super-secure-token"}

# Optional environment variables
ALLOWED_IP_RANGES=203.0.113.0/24,198.51.100.0/24
TRUSTED_PROXY_CIDRS=
AUTH_FAILURE_RATE=10/60
MAX_PAYLOAD_MB=5
UPSTREAM_TIMEOUT=10
LOG_ERROR_DETAIL=

# Hot reload
POLICY_PATH=
POLICY_RELOAD_INTERVAL=30

# Dry-run + audit fan-out + metrics
POLICY_AUDIT_ONLY=
AUDIT_WEBHOOK_URL=
METRICS_TOKEN=
